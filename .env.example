# Optional: use a different publicly accessible live-darshan feed.
VITE_LIVE_DARSHAN_FEED_URL=https://raw.githubusercontent.com/mohantysre-ai/divinity-harmony/main/public/live-darshan-feed.json

# Optional server-side enhancements. Never expose ANTHROPIC_API_KEY as VITE_*.
ANTHROPIC_API_KEY=
DH_DB_PATH=/data/divinity-harmony.db

# Optional donation/support destination (Razorpay page or UPI URI).
VITE_SUPPORT_URL=

# Supabase browser configuration (required for Sign in / Create account).
# From https://supabase.com/dashboard → your project → Project Settings → API:
#   Project URL          → VITE_SUPABASE_URL
#   Publishable / anon   → VITE_SUPABASE_PUBLISHABLE_KEY
# Then run: supabase/setup.sql in the SQL Editor (creates avatars bucket + RLS).
# Auth email redirects: set Site URL to https://mantra.sigq.in (see supabase/AUTH_URLS.md).
# Test: node --env-file=.env scripts/test-supabase.mjs
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=https://mantra.sigq.in
